{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/slinky07/qa-suite/qa-suite/references/finding-reconciliation-inventory-v1.schema.json",
  "title": "QA-Suite finding reconciliation proposal inventory",
  "description": "Protocol version 1 frozen accounting for every selected lane execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "run_id",
    "candidate",
    "created_at",
    "dispatch_manifest",
    "previous_ledger",
    "reports",
    "unexecuted"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol": {
      "const": "qa-suite-finding-reconciliation"
    },
    "run_id": {
      "type": "string",
      "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\..*)?$)[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git-commit",
            "build",
            "release",
            "opaque"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "dispatch_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "previous_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema_version",
        "sha256",
        "row_count"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "enum": [
            1,
            2
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution_id",
          "lane",
          "report",
          "sidecar",
          "proposals"
        ],
        "properties": {
          "execution_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "lane": {
            "oneOf": [
              {
                "enum": [
                  "smoke-qa",
                  "regression-qa",
                  "bob-qa",
                  "performance-qa",
                  "security-qa",
                  "api-qa",
                  "compatibility-qa",
                  "reliability-qa",
                  "deployment-qa",
                  "data-integrity-qa"
                ]
              },
              {
                "type": "string",
                "pattern": "^temporary-qa-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{64}$"
              }
            ]
          },
          "report": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "sidecar": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "proposals": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "local_id",
                "source_content_sha256",
                "content_sha256",
                "component",
                "severity",
                "priority",
                "sensitivity_classification",
                "comparison"
              ],
              "properties": {
                "local_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "source_content_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "component": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "enum": [
                    "S1",
                    "S2",
                    "S3",
                    "S4"
                  ]
                },
                "priority": {
                  "enum": [
                    "P0",
                    "P1",
                    "P2",
                    "P3"
                  ]
                },
                "sensitivity_classification": {
                  "enum": [
                    "standard",
                    "security-s1-s2",
                    "uncertain",
                    "human-sensitive"
                  ]
                },
                "comparison": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "storage",
                        "repro_steps",
                        "expected_result",
                        "actual_result",
                        "environment",
                        "safe_evidence_refs"
                      ],
                      "properties": {
                        "storage": {
                          "const": "sanitized"
                        },
                        "repro_steps": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "expected_result": {
                          "type": "string",
                          "minLength": 1
                        },
                        "actual_result": {
                          "type": "string",
                          "minLength": 1
                        },
                        "environment": {
                          "type": "string",
                          "minLength": 1
                        },
                        "safe_evidence_refs": {
                          "type": "array",
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "storage",
                        "reason_code",
                        "safe_evidence_refs"
                      ],
                      "properties": {
                        "storage": {
                          "const": "withheld"
                        },
                        "reason_code": {
                          "const": "sensitive-manual-handling"
                        },
                        "safe_evidence_refs": {
                          "type": "array",
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "unexecuted": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution_id",
          "lane",
          "state",
          "reason_code",
          "explanation"
        ],
        "properties": {
          "execution_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "lane": {
            "oneOf": [
              {
                "enum": [
                  "smoke-qa",
                  "regression-qa",
                  "bob-qa",
                  "performance-qa",
                  "security-qa",
                  "api-qa",
                  "compatibility-qa",
                  "reliability-qa",
                  "deployment-qa",
                  "data-integrity-qa"
                ]
              },
              {
                "type": "string",
                "pattern": "^temporary-qa-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{64}$"
              }
            ]
          },
          "state": {
            "enum": [
              "gated",
              "blocked"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
