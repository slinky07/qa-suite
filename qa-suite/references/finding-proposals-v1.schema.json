{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/slinky07/qa-suite/qa-suite/references/finding-proposals-v1.schema.json",
  "title": "QA-Suite lane proposal sidecar",
  "description": "Protocol version 1 machine-readable proposals for one immutable lane report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "run_id",
    "execution_id",
    "candidate",
    "lane",
    "report",
    "proposals"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol": {
      "const": "qa-suite-finding-reconciliation"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git-commit",
            "build",
            "release",
            "opaque"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lane": {
      "oneOf": [
        {
          "enum": [
            "smoke-qa",
            "regression-qa",
            "bob-qa",
            "performance-qa",
            "security-qa",
            "api-qa",
            "compatibility-qa",
            "reliability-qa",
            "deployment-qa",
            "data-integrity-qa"
          ]
        },
        {
          "type": "string",
          "pattern": "^temporary-qa-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{64}$"
        }
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "proposals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_id",
          "title",
          "source_content_sha256",
          "component",
          "location",
          "oracle",
          "severity",
          "priority",
          "sensitivity_classification",
          "comparison"
        ],
        "properties": {
          "local_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "oracle": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "S1",
              "S2",
              "S3",
              "S4"
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "sensitivity_classification": {
            "enum": [
              "standard",
              "security-s1-s2",
              "uncertain",
              "human-sensitive"
            ]
          },
          "comparison": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "storage",
                  "repro_steps",
                  "expected_result",
                  "actual_result",
                  "environment",
                  "safe_evidence_refs"
                ],
                "properties": {
                  "storage": {
                    "const": "sanitized"
                  },
                  "repro_steps": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "expected_result": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actual_result": {
                    "type": "string",
                    "minLength": 1
                  },
                  "environment": {
                    "type": "string",
                    "minLength": 1
                  },
                  "safe_evidence_refs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "storage",
                  "repro_steps",
                  "expected_result",
                  "actual_result",
                  "environment",
                  "local_evidence_refs"
                ],
                "properties": {
                  "storage": {
                    "const": "sensitive-local"
                  },
                  "repro_steps": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "expected_result": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actual_result": {
                    "type": "string",
                    "minLength": 1
                  },
                  "environment": {
                    "type": "string",
                    "minLength": 1
                  },
                  "local_evidence_refs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
