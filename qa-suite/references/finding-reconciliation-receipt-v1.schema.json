{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/slinky07/qa-suite/qa-suite/references/finding-reconciliation-receipt-v1.schema.json",
  "title": "QA-Suite finding reconciliation receipt",
  "description": "Protocol version 1 sanitized audit receipt for complete proposal accounting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "run_id",
    "supersedes_run_id",
    "candidate",
    "dispatch_manifest",
    "inventory",
    "ledger",
    "reconciled_at",
    "decisions",
    "finding_results",
    "summary",
    "prominent_risks",
    "persistence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol": {
      "const": "qa-suite-finding-reconciliation"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "supersedes_run_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "dispatch_manifest": {
      "$ref": "#/$defs/artifact_ref"
    },
    "inventory": {
      "$ref": "#/$defs/artifact_ref"
    },
    "ledger": {
      "$ref": "#/$defs/ledger_result"
    },
    "reconciled_at": {
      "type": "string",
      "format": "date-time"
    },
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "finding_results": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/finding_result"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "prominent_risks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/prominent_risk"
      }
    },
    "persistence": {
      "$ref": "#/$defs/persistence"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "persistence": {
            "properties": {
              "publication_state": {
                "const": "blocked-not-published"
              }
            },
            "required": [
              "publication_state"
            ]
          }
        },
        "required": [
          "persistence"
        ]
      },
      "then": {
        "properties": {
          "ledger": {
            "properties": {
              "sha256_after": {
                "type": "null"
              },
              "row_count_after": {
                "type": "null"
              }
            }
          },
          "summary": {
            "properties": {
              "blocked": {
                "type": "integer",
                "minimum": 1
              },
              "unresolved": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "persistence": {
            "properties": {
              "publication_state": {
                "const": "pending-human-commit"
              }
            },
            "required": [
              "publication_state"
            ]
          }
        },
        "required": [
          "persistence"
        ]
      },
      "then": {
        "properties": {
          "ledger": {
            "properties": {
              "sha256_after": {
                "$ref": "#/$defs/sha256"
              },
              "row_count_after": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "summary": {
            "properties": {
              "blocked": {
                "const": 0
              },
              "unresolved": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "lane_identity": {
      "oneOf": [
        {
          "enum": [
            "smoke-qa",
            "regression-qa",
            "bob-qa",
            "performance-qa",
            "security-qa",
            "api-qa",
            "compatibility-qa",
            "reliability-qa",
            "deployment-qa",
            "data-integrity-qa"
          ]
        },
        {
          "type": "string",
          "pattern": "^temporary-qa-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9a-f]{64}$"
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git-commit",
            "build",
            "release",
            "opaque"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ledger_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema_version_before",
        "schema_version_after",
        "sha256_before",
        "sha256_after",
        "row_count_before",
        "row_count_after"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schema_version_before": {
          "enum": [
            1,
            2
          ]
        },
        "schema_version_after": {
          "enum": [
            1,
            2
          ]
        },
        "sha256_before": {
          "$ref": "#/$defs/sha256"
        },
        "sha256_after": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "row_count_before": {
          "type": "integer",
          "minimum": 0
        },
        "row_count_after": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "proposal_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "lane",
        "report_pointer",
        "report_sha256",
        "local_id",
        "source_content_sha256",
        "content_sha256"
      ],
      "properties": {
        "execution_id": {
          "$ref": "#/$defs/identifier"
        },
        "lane": {
          "$ref": "#/$defs/lane_identity"
        },
        "report_pointer": {
          "type": "string",
          "minLength": 1
        },
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "local_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidate_finding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_field": {
      "enum": [
        "component",
        "repro_steps",
        "expected_result",
        "actual_result",
        "environment",
        "candidate"
      ]
    },
    "evidence_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence_field"
      }
    },
    "created_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "disposition",
        "stable_finding_id",
        "candidate_finding_ids",
        "reason_code",
        "explanation",
        "evidence_fields"
      ],
      "properties": {
        "proposal": {
          "$ref": "#/$defs/proposal_ref"
        },
        "candidate_finding_ids": {
          "$ref": "#/$defs/candidate_finding_ids"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "const": "created"
        },
        "stable_finding_id": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "const": "new-evidenced-finding"
        },
        "evidence_fields": {
          "$ref": "#/$defs/evidence_fields"
        }
      }
    },
    "matched_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "disposition",
        "stable_finding_id",
        "candidate_finding_ids",
        "reason_code",
        "explanation",
        "evidence_fields"
      ],
      "properties": {
        "proposal": {
          "$ref": "#/$defs/proposal_ref"
        },
        "candidate_finding_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/candidate_finding_ids"
            }
          ],
          "minItems": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "const": "matched"
        },
        "stable_finding_id": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "const": "same-evidenced-defect"
        },
        "evidence_fields": {
          "$ref": "#/$defs/evidence_fields"
        }
      }
    },
    "rejected_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "disposition",
        "candidate_finding_ids",
        "reason_code",
        "explanation",
        "evidence_fields"
      ],
      "properties": {
        "proposal": {
          "$ref": "#/$defs/proposal_ref"
        },
        "candidate_finding_ids": {
          "$ref": "#/$defs/candidate_finding_ids"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "const": "rejected"
        },
        "reason_code": {
          "enum": [
            "unsupported-evidence",
            "tooling-or-environment-failure",
            "assumption-as-finding",
            "duplicate-of-named-stable-finding",
            "candidate-mismatch",
            "malformed-or-incomplete-proposal"
          ]
        },
        "evidence_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_field"
          }
        }
      }
    },
    "blocked_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "disposition",
        "candidate_finding_ids",
        "reason_code",
        "explanation",
        "evidence_fields",
        "unblock_condition"
      ],
      "properties": {
        "proposal": {
          "$ref": "#/$defs/proposal_ref"
        },
        "candidate_finding_ids": {
          "$ref": "#/$defs/candidate_finding_ids"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "const": "blocked"
        },
        "reason_code": {
          "enum": [
            "sensitive-manual-handling",
            "candidate-drift",
            "report-drift",
            "proposal-drift",
            "ledger-drift",
            "manual-semantic-review-required"
          ]
        },
        "evidence_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence_field"
          }
        },
        "unblock_condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/created_decision"
        },
        {
          "$ref": "#/$defs/matched_decision"
        },
        {
          "$ref": "#/$defs/rejected_decision"
        },
        {
          "$ref": "#/$defs/blocked_decision"
        }
      ]
    },
    "finding_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stable_finding_id",
        "proposals",
        "report_pointers"
      ],
      "properties": {
        "stable_finding_id": {
          "type": "string",
          "minLength": 1
        },
        "proposals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/proposal_ref"
          }
        },
        "report_pointers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoried",
        "created",
        "matched",
        "rejected",
        "blocked",
        "unresolved"
      ],
      "properties": {
        "inventoried": {
          "type": "integer",
          "minimum": 0
        },
        "created": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "prominent_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal",
        "severity",
        "priority",
        "disposition",
        "stable_finding_id",
        "reason_code"
      ],
      "properties": {
        "proposal": {
          "$ref": "#/$defs/proposal_ref"
        },
        "severity": {
          "enum": [
            "S1",
            "S2",
            "S3",
            "S4"
          ]
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "disposition": {
          "enum": [
            "created",
            "matched",
            "rejected",
            "blocked"
          ]
        },
        "stable_finding_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_state",
        "dispatch_manifest_tracked",
        "inventory_tracked",
        "receipt_tracked",
        "ledger_tracked",
        "dispatch_manifest_differs_from_head",
        "inventory_differs_from_head",
        "receipt_differs_from_head",
        "ledger_differs_from_head",
        "head_commit_at_publication"
      ],
      "properties": {
        "publication_state": {
          "enum": [
            "blocked-not-published",
            "pending-human-commit"
          ]
        },
        "dispatch_manifest_tracked": {
          "type": "boolean"
        },
        "inventory_tracked": {
          "type": "boolean"
        },
        "receipt_tracked": {
          "type": "boolean"
        },
        "ledger_tracked": {
          "type": "boolean"
        },
        "dispatch_manifest_differs_from_head": {
          "type": "boolean"
        },
        "inventory_differs_from_head": {
          "type": "boolean"
        },
        "receipt_differs_from_head": {
          "type": "boolean"
        },
        "ledger_differs_from_head": {
          "type": "boolean"
        },
        "head_commit_at_publication": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
